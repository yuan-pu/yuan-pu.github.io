<ul class="cv-entry-list">
  {% assign work = data[1] | sort: 'startDate' | reverse %}
  {% for content in work %}
    <li class="cv-entry">
      <div class="cv-entry-date">
        {% if content.startDate and content.startDate != '' %}
          {% assign start_date = content.startDate | split: '-' | slice: 0, 2 | join: '.' %}
          {% assign end_date = content.endDate | default: 'Present' | split: '-' | slice: 0, 2 | join: '.' %}
          {{ start_date }} – {{ end_date }}
        {% endif %}
        {% if content.location %}
          <span class="cv-entry-location">{{ content.location }}</span>
        {% endif %}
      </div>
      <div>
        <h3 class="cv-entry-title" data-toc-skip>
          {% if content.url and content.url != '' %}
            <a href="{{ content.url }}">{{ content.position }}</a>
          {% else %}
            {{ content.position }}
          {% endif %}
        </h3>
        <p class="cv-entry-subtitle">{{ content.name }}</p>
        {% if content.summary %}
          <p class="cv-entry-summary">{{ content.summary }}</p>
        {% endif %}
        {% if content.highlights and content.highlights.size > 0 %}
          <ul class="cv-entry-items">
            {% for item in content.highlights %}
              <li>{{ item }}</li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
