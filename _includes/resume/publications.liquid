<ul class="cv-entry-list">
  {% assign publications = data[1] | sort: 'releaseDate' | reverse %}
  {% for content in publications %}
    <li class="cv-entry cv-publication">
      <div class="cv-entry-date">
        {% if content.releaseDate %}{{ content.releaseDate | split: '-' | join: '.' }}{% endif %}
      </div>
      <div>
        <h3 class="cv-entry-title" data-toc-skip>
          {% if content.url and content.url != '' %}
            <a href="{{ content.url }}">{{ content.name }}</a>
          {% else %}
            {{ content.name }}
          {% endif %}
        </h3>
        {% if content.publisher %}
          <p class="cv-entry-subtitle">{{ content.publisher }}</p>
        {% endif %}
        {% if content.summary %}
          <p class="cv-entry-summary">{{ content.summary }}</p>
        {% endif %}
      </div>
    </li>
  {% endfor %}
</ul>
